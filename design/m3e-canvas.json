{
  "title": "随记单词",
  "brief": "用手机摄像头识别手写单词、短语和例句，校对后生成卡片，并按间隔复习。扫描帧只在浏览器内存中处理，不保存到相册。",
  "frame": "phone",
  "platform": "web",
  "paletteKey": "teal",
  "theme": { "dark": false, "bothModes": true, "contrast": "standard", "shape": "rounded", "font": "system", "emphasized": true, "motion": "expressive" },
  "frames": [
    { "id": "home", "name": "今日", "x": 0, "y": 0, "note": "展示今日待复习数量与扫描入口，提示数据只保存在本机浏览器。" },
    { "id": "scan", "name": "扫描单词本", "x": 492, "y": 0, "note": "调用网页实时摄像头，仅提取当前画面帧做本地识别，不创建相册照片。" },
    { "id": "confirm", "name": "校对识别结果", "x": 984, "y": 0, "note": "逐条修改英文单词、短语或例句及中文释义，确认后才加入词库。" },
    { "id": "deck", "name": "我的词库", "x": 1476, "y": 0, "note": "搜索、编辑和管理已保存的单词卡。" },
    { "id": "study", "name": "开始复习", "x": 1968, "y": 0, "note": "先回忆再翻卡，按忘记、模糊、记得安排下次复习。" }
  ],
